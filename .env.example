GG_OPEN_API_KEY=
# https://www.data.go.kr/data/15134735/openapi.do 활용신청 후 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
# https://open.neis.go.kr/ 나이스 교육정보 개방 포털 인증키
NEIS_API_KEY=
# https://www.schoolinfo.go.kr/ 학교알리미 Open API 인증키
SCHOOLINFO_API_KEY=
# https://kosis.kr/openapi/ 활용신청 인증키
KOSIS_API_KEY=
